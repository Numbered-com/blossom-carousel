{
	"name": "@numbered/carousel",
	"version": "1.0.0",
	"private": true,
	"author": "Jesper Vos",
	"license": "MIT",
	"description": "A native-scroll-first carousel component for the web.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Numbered-com/carousel.git"
	},
	"bugs": {
		"url": "https://github.com/Numbered-com/carousel/issues"
	},
	"main": "index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"build": "bun run --filter '*' build",
		"publish:all": "bun run build && for p in core react alpine; do bun publish --cwd packages/$p || exit 1; done",
		"dev": "bun run --filter @numbered/carousel-dev dev",
		"dev:vue": "bun run --filter @numbered/carousel-vue dev",
		"dev:react": "bun run --filter @numbered/carousel-react dev",
		"dev:svelte": "bun run --filter @numbered/carousel-svelte dev",
		"dev:web": "bun run --filter @numbered/carousel-web dev",
		"dev:alpine": "bun run --filter @numbered/carousel-alpine dev"
	},
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"biome": "^0.3.3",
		"turbo": "^2.10.7"
	},
	"overrides": {
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.14"
}